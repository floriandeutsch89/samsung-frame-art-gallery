# Image Collection
IMAGES_DIR=./images

# Authentication (optional)
# Set a password to protect the app. Leave empty to disable authentication.
APP_PASSWORD=

# TV Configuration (optional - leave empty for auto-discovery)
TV_IP=

# Image Processing Defaults
DEFAULT_CROP_PERCENT=5
DEFAULT_MATTE_PERCENT=10

# Source Tabs (optional)
# Set to 1 to hide the Metropolitan Museum of Art tab
DISABLE_MET_GALLERY=1

# Application Domain (update to your domain)
DOMAIN=artgallery.example.com
