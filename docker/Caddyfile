# Caddy automatically generates self-signed certificates for HTTPS
# and handles all certificate management

# Listen on the domain (from DOMAIN environment variable) with HTTPS
{$DOMAIN}:443 {
  # Use self-signed certificates (auto-generated by Caddy with 'internal')
  tls internal
  
  # Proxy all requests to the FastAPI backend
  reverse_proxy app:8080
  
  log {
    output stdout
  }
}

# Listen on HTTP (80) for the domain and redirect to HTTPS
{$DOMAIN}:80 {
  redir https://{host}{uri} permanent
}
